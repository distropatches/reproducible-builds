From 558c538b5390d7a15c7f98b491d8971529872eba Mon Sep 17 00:00:00 2001
From: Aesara Binder <aesara@mailbox.org>
Date: Tue, 21 Jan 2025 08:33:29 +1030
Subject: [PATCH 25/25] gui/main.py: Rm GdkPixbuf utf8 workaround (WinNT)

Removes a workaround (4d1ed4e) that replaces the default new_from_file,
new_from_file_at_scale, and new_from_file_at_size functions with their
respective utf8 functions (identified with the "_utf8" suffix)

It's been 10 years and the workaround is no longer required -- the
commit that fixes this is 8 years old.
https://gitlab.gnome.org/GNOME/gdk-pixbuf/-/commit/85b4f6c291c5b928b4b60a31dfac83ec2927f345

Closes #1274

Signed-off-by: Aesara Binder <aesara@mailbox.org>
(cherry picked from commit 979257395cf5320321e12805f7625b3975823241)
---
 gui/main.py | 16 ----------------
 1 file changed, 16 deletions(-)

diff --git a/gui/main.py b/gui/main.py
index d12e17f3e..88b1be466 100644
--- a/gui/main.py
+++ b/gui/main.py
@@ -18,7 +18,6 @@
 import logging
 import warnings
 
-from lib.gibindings import GdkPixbuf
 from optparse import OptionParser
 
 import lib.config
@@ -34,23 +33,8 @@
 
 def _init_gtk_workarounds():
     """Initialize some workarounds for unoptimal GTK behavior"""
-    # Via https://code.google.com/p/quodlibet/source/browse/quodlibet/
     logger.debug("Adding GTK workarounds...")
 
-    # On windows the default variants only do ANSI paths, so replace them.
-    # In some typelibs they are replaced by default, in some don't..
-    if os.name == "nt":
-        for name in ["new_from_file_at_scale", "new_from_file_at_size",
-                     "new_from_file"]:
-            cls = GdkPixbuf.Pixbuf
-            func = getattr(cls, name + "_utf8", None)
-            if func:
-                logger.debug(
-                    "Monkeypatching GdkPixbuf.Pixbuf.%s with %r",
-                    name, func,
-                )
-                setattr(cls, name, func)
-
     # Wayland "workaround" to avoid input freeze on pointer grabs.
     # Respect existing envvars for testing (and general courtesy).
     # This relies on XWayland being available.
